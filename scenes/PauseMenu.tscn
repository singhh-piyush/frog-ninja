[node name="PauseMenu" type="CanvasLayer"]
process_mode = 3
script = ExtResource("1_pm")

[node name="MenuButton" type="Button" parent="."]
offset_left = 4.0
offset_top = 4.0
offset_right = 26.0
offset_bottom = 26.0
flat = true
icon = ExtResource("4_settings")
expand_icon = true
script = ExtResource("2_hover")

[node name="Overlay" type="Control" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Dim" type="ColorRect" parent="Overlay"]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0, 0.7)

[node name="Center" type="CenterContainer" parent="Overlay"]
anchor_right = 1.0
anchor_bottom = 1.0

[node name="VBox" type="VBoxContainer" parent="Overlay/Center"]
custom_minimum_size = Vector2(150, 0)
theme_override_constants/separation = 8
alignment = 1

[node name="Title" type="Label" parent="Overlay/Center/VBox"]
